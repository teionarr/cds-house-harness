# Model — provider is a config value (see config/llm.py)
HOUSE_HARNESS_MODEL=anthropic:claude-sonnet-4-6
ANTHROPIC_API_KEY=          # required
OPENAI_API_KEY=             # optional (only if you switch the model seam to OpenAI)

# Owned corpus store
DATABASE_URL=sqlite:///./data/house_harness.db   # corpus fits WholeCorpus; pgvector is the scale path only

# Observability — LangSmith. Graceful: with no API key, tracing is auto-disabled
# (no crash). Doppler is optional; without it install.sh falls back to this file.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=          # optional — omit to run with tracing off
LANGSMITH_PROJECT=house-harness
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com  # point at a self-hosted/VPC instance for sensitive corpora

# Serve mode — DEFAULT live (real pipeline). Set to `mock` ONLY for the Phase-1
# deploy skeleton; mock answers self-identify (mode=mock) and fail `make validate`.
HOUSE_HARNESS_SERVE_MODE=live

# Live endpoint auth — agents present this as a bearer token (/health stays open)
HOUSE_HARNESS_API_TOKEN=
